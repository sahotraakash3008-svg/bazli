  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "Customer, seller, rider, and admin user profiles"
    },
    "/users/{userId}/addresses/{addressId}": {
      "schema": "userAddresses",
      "description": "User saved shipping addresses"
    },
    "/users/{userId}/favorites/{itemId}": {
      "schema": "userFavorites",
      "description": "Bookmarked favorite products and restaurants"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "userNotifications",
      "description": "Direct user push alerts and order notifications"
    },
    "/users/{userId}/cart/current": {
      "schema": "userCart",
      "description": "Current active shopping cart for persistent checkout across devices"
    },
    "/sellers/{sellerId}": {
      "schema": "sellers",
      "description": "Merchants, grocery vendors, restaurants, and cloud kitchens"
    },
    "/sellers/{sellerId}/branches/{branchId}": {
      "schema": "restaurantBranches",
      "description": "Multi-location restaurant branches and outlet hubs"
    },
    "/categories/{categoryId}": {
      "schema": "categories",
      "description": "Top-level grocery aisles, cuisines, and stationery departments"
    },
    "/categories/{categoryId}/subcategories/{subcategoryId}": {
      "schema": "subcategories",
      "description": "Nested sub-aisles and food subcategories"
    },
    "/products/{productId}": {
      "schema": "products",
      "description": "Unified inventory of grocery items, mandi staples, dishes, and stationery"
    },
    "/orders/{orderId}": {
      "schema": "orders",
      "description": "Master purchases and live order deliveries"
    },
    "/orders/{orderId}/status_history/{historyId}": {
      "schema": "orderStatusHistory",
      "description": "Order progression history log"
    },
    "/delivery_partners/{partnerId}": {
      "schema": "deliveryPartners",
      "description": "Delivery fleet rider profiles, GPS coordinates, and wallets"
    },
    "/coupons/{couponId}": {
      "schema": "coupons",
      "description": "Promotional discount codes"
    },
    "/offers/{offerId}": {
      "schema": "offers",
      "description": "Deals of the day, category promotions, and flash sales"
    },
    "/banners/{bannerId}": {
      "schema": "banners",
      "description": "Homepage hero promotional banner slides"
    },
    "/reviews/{reviewId}": {
      "schema": "reviews",
      "description": "Aggregated reviews and ratings for items, stores, and riders"
    },
    "/admin_settings/{configId}": {
      "schema": "adminSettings",
      "description": "Global application configuration documents"
    },
    "/bargain_sessions/{sessionId}": {
      "schema": "bargainSessions",
      "description": "Active and past AI price negotiation sessions"
    },
    "/audit_logs/{logId}": {
      "schema": "auditLogs",
      "description": "Admin and vendor audit log stream"
    }
  }
