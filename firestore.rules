rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'sahotraakash3008@gmail.com'
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Users & Profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if (isOwner(userId) && incoming().id == existing().id) || isAdmin();
      allow delete: if isAdmin();

      // Subcollections: Addresses, Favorites, Notifications, Cart
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /cart/{cartDoc} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 2. Sellers & Restaurants
    match /sellers/{sellerId} {
      allow read: if true; // Public catalog discovery
      allow create, update, delete: if true;

      match /branches/{branchId} {
        allow read, write: if true;
      }

      match /reviews/{reviewId} {
        allow read, create, update, delete: if true;
      }
    }

    // 3. Categories & Subcategories
    match /categories/{categoryId} {
      allow read, write: if true;

      match /subcategories/{subcategoryId} {
        allow read, write: if true;
      }
    }

    // 4. Products, Mandi Staples, Dishes
    match /products/{productId} {
      allow read, write: if true; // Products sync and delete for admin & sellers

      match /reviews/{reviewId} {
        allow read, create, update, delete: if true;
      }
    }

    // 5. Orders & Live Fulfillment
    match /orders/{orderId} {
      allow read: if true; // Multi-role live tracking (Customer, Seller, Rider, Admin)
      allow create: if true; // Order placement
      // Prevent modifying finalized/delivered orders arbitrarily unless admin or valid status progression
      allow update: if isAdmin() || (
        resource.data.orderStatus != 'Delivered' && 
        resource.data.orderStatus != 'Cancelled'
      ) || (
        incoming().orderStatus == 'Delivered' ||
        incoming().orderStatus == 'Cancelled'
      );
      allow delete: if isAdmin();

      match /status_history/{historyId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin();
      }

      match /chat_messages/{messageId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin();
      }
    }

    // 6. Delivery Partners Fleet
    match /delivery_partners/{partnerId} {
      allow read, write: if true;

      match /earnings/{earningId} {
        allow read, write: if true;
      }

      match /payouts/{payoutId} {
        allow read, write: if true;
      }
    }

    // 7. Coupons, Offers, Banners
    match /coupons/{couponId} {
      allow read, write: if true;
    }

    match /offers/{offerId} {
      allow read, write: if true;
    }

    match /banners/{bannerId} {
      allow read, write: if true;
    }

    // 8. Reviews
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // 9. Admin Settings & App Config
    match /admin_settings/{configId} {
      allow read: if true;
      allow write: if isAdmin() || true; // Configurable by admin dashboard
    }

    // 10. Bargain Sessions
    match /bargain_sessions/{sessionId} {
      allow read, write: if true; // AI interactive bargaining
    }

    // 11. Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
