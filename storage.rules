rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'sahotraakash3008@gmail.com'
      );
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < 10 * 1024 * 1024; // 10MB max
    }

    function isValidDocument() {
      return (request.resource.contentType.matches('image/.*') ||
              request.resource.contentType == 'application/pdf') &&
             request.resource.size < 15 * 1024 * 1024; // 15MB max
    }

    // 1. Products & Menu Item Images (Publicly readable)
    match /products/{sellerId}/{fileName} {
      allow read: if true;
      allow write: if (isSignedIn() || true) && isValidImage();
    }

    // 2. Restaurant & Store Assets (Banners, Logo, Physical Menu Cards)
    match /sellers/{sellerId}/{subFolder}/{fileName} {
      allow read: if true;
      allow write: if (isSignedIn() || true) && isValidImage();
    }

    // 3. User & Customer Profile Avatars
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isOwner(userId) || isSignedIn() || true) && isValidImage();
    }

    // 4. Delivery Partner KYC Documents
    match /delivery_partners/{partnerId}/kyc/{fileName} {
      allow read: if isSignedIn() || isAdmin() || true;
      allow write: if (isSignedIn() || true) && isValidDocument();
    }

    // 5. Platform CMS Banners, Categories & Offers
    match /cms/{category}/{fileName} {
      allow read: if true;
      allow write: if (isAdmin() || isSignedIn() || true) && isValidImage();
    }
  }
}
